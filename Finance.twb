      <aliases enabled='yes' />
      <column caption='Avg INT Rate ' datatype='real' name='[Avg DTI (copy)_2943990455980041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([int_rate])' />
      </column>
      <column caption='Avg DTI' datatype='real' name='[Calculation_0689991279476744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([dti])' />
      </column>
      <column caption='Good Loan %' datatype='real' name='[Calculation_2943990431039488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Good vs Bad Loan]=&apos;Good Loan&apos; THEN [id] END)&#13;&#10;/COUNT([id])' />
      </column>
      <column caption='Good Loan Applications' datatype='integer' name='[Calculation_2943990436552705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Good vs Bad Loan]=&apos;Good Loan&apos; THEN [id]END)' />
      </column>
      <column caption='Dynamic Measure' datatype='integer' name='[Calculation_2943990467297290]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Total Loan Applications&quot; THEN [Calculation_8439624058224640]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Total Funded Amount&quot; THEN [Calculation_8439624068657158]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Total Amount Received&quot; THEN [Total Funded Amount (copy)_0689991258251264]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Total Loan Applications' datatype='integer' name='[Calculation_8439624058224640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([id])' />
      </column>
      <column caption='MTD Total Loan Applications' datatype='integer' name='[Calculation_8439624059236353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT( IF &#13;&#10;DATEDIFF(&apos;month&apos;,[issue_date],{MAX([issue_date])})=0&#13;&#10;THEN [id]&#13;&#10;END&#13;&#10;)' />
